<Window x:Class="Cappa.Editor.EditorWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:Cappa.Editor"
        Width="1100" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/cappa.ico">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video -->
        <Grid Grid.Row="0" Background="Black" MouseLeftButtonUp="OnVideoClick">
            <MediaElement x:Name="Video" Stretch="Uniform" />
            <Border x:Name="Notice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,16" Padding="14,7" CornerRadius="16" Background="#E6202124">
                <TextBlock x:Name="NoticeText" Foreground="White" />
            </Border>
        </Grid>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="16,10" LastChildFill="False">
            <Button x:Name="UndoButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Click="OnUndo" ToolTip="Undo  Ctrl+Z">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
            </Button>
            <Button x:Name="RedoButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Click="OnRedo" ToolTip="Redo  Ctrl+Y">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;" />
            </Button>
            <Separator DockPanel.Dock="Left" Margin="4,2,10,2" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
            <Button x:Name="SplitButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Click="OnSplit" ToolTip="Split at playhead  Ctrl+B">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" Margin="0,0,6,0" />
                    <TextBlock Text="Split" />
                </StackPanel>
            </Button>
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Click="OnDelete" ToolTip="Delete clip  Delete">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" Margin="0,0,6,0" />
                    <TextBlock Text="Delete Clip" />
                </StackPanel>
            </Button>

            <Button x:Name="ExportButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="0" Click="OnExportMenu"
                    ToolTip="Save as Video  Ctrl+E · Copy to Clipboard  Ctrl+Shift+C · Save as GIF  Ctrl+Shift+E">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72D;" Margin="0,0,6,0" />
                    <TextBlock Text="Export" />
                    <TextBlock Style="{StaticResource Glyph}" FontSize="9" Text="&#xE70D;" Margin="6,0,0,0" />
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Save as Video…" InputGestureText="Ctrl+E" Click="OnSaveVideo" />
                        <MenuItem Header="Copy to Clipboard" InputGestureText="Ctrl+Shift+C" Click="OnCopyToClipboard" />
                        <MenuItem Header="Save as GIF…" InputGestureText="Ctrl+Shift+E" Click="OnSaveGif" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="OnShowInExplorer" Content="Show in Explorer" />
            <TextBlock x:Name="LengthText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#6B6B6B" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="24,0">
                <Button x:Name="PlayButton" Style="{StaticResource ToolButton}" Width="40" Click="OnPlay" ToolTip="Play / Pause  Space">
                    <TextBlock x:Name="PlayGlyph" Style="{StaticResource Glyph}" FontSize="14" Text="&#xE768;" />
                </Button>
                <TextBlock x:Name="TimeText" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14" MinWidth="80" Text="0:00.0" />
            </StackPanel>
        </DockPanel>

        <!-- Timeline: lane headers on the left, lanes on the right -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Border Height="{x:Static editor:TimelineControl.RulerHeight}" />
                <Border Height="{x:Static editor:TimelineControl.LaneSpacing}" />
                <StackPanel Height="{x:Static editor:TimelineControl.VideoHeight}" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" Foreground="#6B6B6B" Margin="0,0,6,0" />
                    <TextBlock Text="Video" VerticalAlignment="Center" Foreground="#6B6B6B" FontSize="12" />
                </StackPanel>
                <ItemsControl x:Name="AudioHeaders">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type editor:AudioTrack}">
                            <Grid Margin="0,6,0,0" Height="{x:Static editor:TimelineControl.AudioHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Width="26" Height="26" Margin="0,0,6,0" Padding="0" Background="Transparent"
                                        BorderThickness="0" Click="OnToggleMute" Tag="{Binding}" ToolTip="Mute / unmute"
                                        ToolTipService.InitialShowDelay="350">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="{Binding MuteGlyph}" Foreground="{Binding Brush}" />
                                </Button>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="#6B6B6B" Text="{Binding VolumeLabel}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Margin="0,1,0,0"
                                            Value="{Binding Volume, Mode=TwoWay}" Focusable="False" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <editor:TimelineControl x:Name="Timeline" Grid.Column="1" VerticalAlignment="Top" Focusable="True" />
        </Grid>

        <!-- Loading / exporting -->
        <Border x:Name="BusyOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" CornerRadius="12" Background="White" MinWidth="280">
                <StackPanel>
                    <TextBlock x:Name="BusyText" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Text="Loading…" />
                    <ProgressBar x:Name="BusyProgress" Height="6" Maximum="1" IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
