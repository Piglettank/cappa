<Window x:Class="Cappa.UI.RecordingOverlay" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight">
    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="6" Padding="14,6" CornerRadius="20" Background="#E6202124" BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#FF3B30" VerticalAlignment="Center" />
            <TextBlock x:Name="ElapsedText" Text="00:00" Foreground="White" FontSize="13" FontWeight="SemiBold"
                       FontFamily="Segoe UI" Margin="10,0,12,0" MinWidth="44" VerticalAlignment="Center" />
            <Button x:Name="PauseButton" Style="{StaticResource PillButton}" Click="OnPauseClick" ToolTip="Pause">
                <TextBlock x:Name="PauseGlyph" FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE769;" />
            </Button>
            <Button Style="{StaticResource PillButton}" Click="OnStopClick" ToolTip="Stop recording (Ctrl+Alt+Shift+R)" Margin="4,0,0,0">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE71A;" Foreground="#FF453A" />
            </Button>
        </StackPanel>
    </Border>
</Window>
